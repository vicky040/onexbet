# Postgres connection string.
DATABASE_URL="postgresql://onexbet:change_me@localhost:5433/onexbet?schema=public"

# Signs agent access/refresh tokens and the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Lifetimes. Agent access token / refresh token / admin session cookie.
ACCESS_TOKEN_TTL="1h"
REFRESH_TOKEN_TTL_DAYS="30"
ADMIN_SESSION_TTL="8h"

# Credentials for the first admin, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@onexbet.app"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Super Admin"

# Set to "true" to have the seed also insert demo agents and transactions.
SEED_DEMO_DATA="true"
