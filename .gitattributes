# Normalise line endings so a Windows checkout does not produce files that
# break on Linux (where CI and Vercel build).
* text=auto

# Shell scripts must stay LF, or the shebang fails with "bad interpreter".
*.sh text eol=lf

# Gradle wrappers and Dart/TS sources are text; keep them LF in the repo.
gradlew text eol=lf
*.dart text
*.ts text
*.tsx text
*.yaml text
*.yml text
*.json text
*.md text

# Binary assets: never touch them.
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
